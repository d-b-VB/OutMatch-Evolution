{
  "name": "outmatch-reach-evolution",
  "version": "0.1.0",
  "description": "Local-first deterministic evolution and audit lab for OutMatch Reach",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "test:unit": "node --test test/engine/board.test.js",
    "test:golden": "node --test test/engine/golden.test.js",
    "verify:step3": "node --test test/evolution/*.test.js",
    "verify:step4": "node --test test/persistence/*.test.js",
    "verify:step5": "node --test test/portable/*.test.js",
    "verify:step6": "node --test test/ui/*.test.js",
    "verify:browser": "node scripts/browser-smoke.mjs",
    "verify:pages": "npm run build && SERVE_ROOT=dist BASE_PATH=/OutMatch-Evolution node scripts/browser-smoke.mjs",
    "verify:fixtures": "node scripts/verify-fixtures.mjs",
    "verify:version": "node scripts/verify-version.mjs",
    "verify:all": "node scripts/verify-all.mjs",
    "verify:golden": "node scripts/verify-golden.mjs"
  }
}
